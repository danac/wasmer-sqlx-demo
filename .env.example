# Native local development. Wasmer Edge injects DB_HOST, DB_PORT, DB_NAME,
# DB_USERNAME, and DB_PASSWORD instead of DATABASE_URL.
DATABASE_URL=mysql://demo:demo@127.0.0.1:3306/items_demo
PORT=3000
BIND_ADDR=127.0.0.1

# Optional. disabled | preferred | required | verify_ca | verify_identity
# Omit to auto-detect: Wasmer hosts use required, everything else preferred.
# DB_SSL_MODE=preferred
