# Native local development. Wasmer Edge injects DB_HOST, DB_PORT, DB_NAME,
# DB_USERNAME, and DB_PASSWORD instead of DATABASE_URL.
DATABASE_URL=mysql://demo:demo@127.0.0.1:3306/items_demo
PORT=3000
BIND_ADDR=127.0.0.1

# Local Docker / MariaDB usually has no TLS. Set this or SQLx may try
# Preferred and fail the handshake. Wasmer Edge should leave this unset
# (or set required): managed MySQL uses TLS with a private CA.
DB_SSL_MODE=disabled
